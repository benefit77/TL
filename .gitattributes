# 统一换行符处理：避免 Windows(CRLF) 与 Linux(LF) 互相提交时产生整文件 diff
# 文本文件在仓库中统一存 LF，检出时由各自平台处理
* text=auto

# 明确按 LF 存储的源码/文本
*.c      text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.pro    text eol=lf
*.pri    text eol=lf
*.ui     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.sh     text eol=lf
*.txt    text eol=lf
*.gitignore text eol=lf

# Windows 批处理保留 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 二进制文件不做任何转换
*.png    binary
*.ico    binary
*.zip    binary
*.xz     binary
*.rar    binary
*.exe    binary
*.dll    binary
*.so     binary
*.a      binary
*.ttf    binary
